{
  "name": "assetsphereappcodebasearchitecture",
  "module": "index.ts",
  "packageManager": "bun@1.3.14",
  "private": true,
  "workspaces": [
    "AssetsphereClientServiceLayerMSC",
    "AssetsphereOrchestratorServiceLayerMSC"
  ],
  "scripts": {
    "start:dev": "turbo dev",
    "start:build": "turbo build",
    "start:lint": "turbo lint",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "client:dev": "turbo dev --filter=@assetsphere/client",
    "client:build": "turbo build --filter=@assetsphere/client",
    "client:lint": "turbo lint --filter=@assetsphere/client",
    "client:install": "bun install --cwd AssetsphereClientServiceLayerMSC",
    "client install": "bun install --cwd AssetsphereClientServiceLayerMSC",
    "server:dev": "turbo dev --filter=@assetsphere/server",
    "server:build": "turbo build --filter=@assetsphere/server",
    "server:lint": "turbo lint --filter=@assetsphere/server",
    "backend:live": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=live",
    "backend live": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=live",
    "backend:local": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=local",
    "backend local": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=local",
    "backend:status": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=status",
    "backend status": "python AssetsphereRunnerScripts/BackendEnvironmentSwitcher.py --target=status",
    "list:cmd": "python AssetsphereRunnerScripts/CommandList.py",
    "list cmd": "python AssetsphereRunnerScripts/CommandList.py"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.4.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
